# Copy to secrets.env only when needed. secrets.env is ignored by Git.
# Values use shell syntax. Avoid spaces unless the value is quoted.

# 1 keeps the built-in MQTT demo publisher active after installation.
DAB_ENABLE_SIMULATOR=1

# Safe default: the broker accepts only local connections.
# For external controllers use 0.0.0.0 together with username/password.
DAB_MQTT_LISTEN_ADDRESS=127.0.0.1

# Optional MQTT authentication. Both values must be set together.
DAB_MQTT_USERNAME=
DAB_MQTT_PASSWORD=
